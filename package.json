{
  "name": "inspector-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "prepare": "pnpm build",
    "build": "pnpm --filter \"./packages/**\" build",
    "dev:playground": "pnpm --filter playground dev",
    "test": "pnpm --filter \"./packages/**\" test",
    "bench": "pnpm --filter @inspector-agent/benchmarks bench",
    "typecheck": "pnpm -r typecheck",
    "test:scripts": "vitest run scripts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "node scripts/release-check.mjs",
    "release:smoke": "node scripts/pack-smoke.mjs",
    "release": "pnpm build && pnpm release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
