{
  "name": "@inspector-agent/verifier",
  "version": "0.3.0",
  "description": "Playwright 로 여러 뷰포트를 스캔하고(inspector-scan CLI) 패치 전후를 재측정하는 레이아웃 결함 검증기",
  "license": "MIT",
  "author": "HamHyunJun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamHyunJun/Inspector-Agent.git",
    "directory": "packages/verifier"
  },
  "homepage": "https://github.com/HamHyunJun/Inspector-Agent/tree/main/packages/verifier#readme",
  "bugs": {
    "url": "https://github.com/HamHyunJun/Inspector-Agent/issues"
  },
  "keywords": [
    "playwright",
    "layout",
    "overflow",
    "viewport",
    "cli",
    "ci",
    "accessibility",
    "focus-trap"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "inspector-scan": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inspector-agent/core": "workspace:^",
    "playwright-core": "1.56.1"
  }
}
