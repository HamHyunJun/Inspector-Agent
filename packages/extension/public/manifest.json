{
  "manifest_version": 3,
  "name": "Inspector-Agent",
  "version": "0.1.0",
  "description": "실제 렌더링 결과에서 레이아웃 오버플로우를 결정론적으로 탐지하고 소스 위치와 함께 대시보드로 보냅니다.",
  "action": {
    "default_title": "Inspector-Agent",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
