{
  "name": "@inspector-agent/engine",
  "version": "0.7.1",
  "description": "결함 저장, 패치 제안·적용·재측정·자동 롤백을 대시보드 없이 수행하는 엔진 (MCP 서버와 inspector-agent CLI 가 사용)",
  "license": "MIT",
  "author": "HamHyunJun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamHyunJun/Inspector-Agent.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/HamHyunJun/Inspector-Agent/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/HamHyunJun/Inspector-Agent/issues"
  },
  "keywords": [
    "layout",
    "patch",
    "rollback",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "inspector-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inspector-agent/core": "workspace:^",
    "@inspector-agent/verifier": "workspace:^",
    "@vue/compiler-sfc": "^3.5.0",
    "diff": "^8.0.0",
    "postcss": "^8.5.0",
    "postcss-scss": "^4.0.9"
  },
  "devDependencies": {
    "@inspector-agent/source-locator": "workspace:*"
  }
}
